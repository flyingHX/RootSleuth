# ============================================================
# AIOps 运营控制台 · 后端环境变量模板
# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，严禁提交真实值
# ============================================================

# ---- 数据库（必填）----
# PostgreSQL 连接串；本地开发也可使用 sqlite+aiosqlite:///./local.db
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/aiops_console

# ---- JWT 认证（生产环境必须替换）----
# 生成方式示例：openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# 平台管理员用户 ID（与认证系统用户一致）
ADMIN_USER_ID=

# ---- 控制台内 LLM API Key 静态加密 ----
# core/mask_crypto.py 使用；生产环境必须显式设置并纳入密钥轮换流程
# （未设置时代码回退内置默认密钥，仅可用于本地演示，见 SECURITY.md）
MASK_KEY=
# services/llm_runtime.py 加解密派生密钥；未设置时回落 JWT_SECRET_KEY
CONSOLE_SECRET_KEY=

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ---- 连接池调优（可选）----
DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=280
DB_POOL_TIMEOUT=30

# ---- 前端注入（可选，Lambda/托管场景使用）----
# VITE_API_BASE_URL=http://127.0.0.1:8000

# ---- AWS Lambda 部署（可选）----
IS_LAMBDA=false
PYTHON_BACKEND_URL=

# ---- 安全（可选）----
# 允许的跨域域名，逗号分隔；留空表示使用默认
ALLOWED_DOMAINS=
