# ============================================================
# AIOps 运营控制台 · 前端环境变量模板
# 复制为 .env.local 后按需修改；.env.local 已被 .gitignore 排除
# ============================================================

# 后端 API 地址（Vite 开发代理已覆盖 /api，通常无需设置）
VITE_API_BASE_URL=http://127.0.0.1:8000

# 站点元信息（可选，用于 SEO/博客页）
VITE_APP_TITLE=
VITE_SITE_URL=
VITE_TWITTER_SITE=
VITE_TWITTER_CREATOR=
