# ===== LLM 配置（LangChain ChatOpenAI 兼容接口，支持 DeepSeek/Qwen/OpenAI）=====
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=5
# 底层重试次数，默认 0（端到端 deadline 由 RAG_LLM_TIMEOUT_SECONDS 统一熔断，
# 底层重试会把单请求最长阻塞放大为 timeout*(retries+1)，加剧 P99 长尾）
LLM_MAX_RETRIES=0

# ===== Milvus =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=aiops_knowledge_base
# 单次向量检索超时（秒）
MILVUS_SEARCH_TIMEOUT=3
# 集合句柄缓存 TTL（秒）：TTL 内复用 Collection 对象，省去每次检索的 has_collection RPC
MILVUS_COLLECTION_CACHE_TTL=5

# ===== Embedding（bge-m3：本地路径或 API，留空则使用确定性降级向量）=====
EMBEDDING_MODEL_PATH=BAAI/bge-m3
EMBEDDING_API_URL=
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT=10
# Embedding API 失败熔断：连续失败 N 次后熔断，窗口内直接走降级向量
EMBEDDING_FAIL_THRESHOLD=3
EMBEDDING_CIRCUIT_SECONDS=30

# ===== RAG 检索/并发调优（P99 长尾治理）=====
# 召回候选数与重排后送入 LLM 的案例数：降低 top_k 可显著缩短 Milvus 与重排耗时
RAG_TOP_K=20
RAG_FINAL_K=3
# 端到端 LLM 等待预算（秒）：超时后立即用 top1 检索结果降级，不再等待
RAG_LLM_TIMEOUT_SECONDS=5
# LLM 推理线程池大小：高并发下过小会形成排队长尾，过大受 LLM 服务吞吐约束
RAG_LLM_MAX_WORKERS=8
# 检索时间过滤窗口（天）
RAG_RECENT_WINDOW_DAYS=30

# ===== 四层业务重排（L1 规则过滤 -> L2 七特征融合 -> L3 Cross-Encoder -> L4 LLM Listwise）=====
# L1 规则硬过滤：案例最大年龄（天）/ 黑名单（逗号分隔）/ 最低净反馈分 / 废弃关键词（逗号分隔）
RERANK_L1_MAX_AGE_DAYS=365
RERANK_L1_BLACKLIST_CASE_IDS=
RERANK_L1_BLACKLIST_SERVICES=
RERANK_L1_MIN_FEEDBACK=-5
RERANK_L1_DEPRECATED_KEYWORDS=
# L2 七特征融合输出条数（召回 20 -> L2 10）
RERANK_L2_TOP_K=10
# L3 Cross-Encoder：需 FlagEmbedding + torch（可选依赖），不可用时自动回退 L2 分数
RERANK_L3_ENABLED=false
RERANK_L3_MODEL=BAAI/bge-reranker-v2-m3
RERANK_L3_DEVICE=cpu
RERANK_L3_BATCH_SIZE=16
RERANK_L3_MAX_LENGTH=512
RERANK_L3_TOP_K=5
# L4 LLM Listwise 独立超时（秒）：超时/JSON 非法/未知 ID 时回退 L3 顺序，不拖垮 P99
RERANK_L4_TIMEOUT_SECONDS=3

# ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_STANDARDIZED=standardized-events
KAFKA_TOPIC_RAW=raw-alerts

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Elasticsearch =====
ES_HOST=http://localhost:9200
ES_INDEX=aiops-events

# ===== 服务间鉴权与多租户（P0）=====
# 鉴权总开关：false 或未配置任何 Key 时鉴权关闭（存量部署兼容，匿名按 default 租户放行）
RAG_AUTH_ENABLED=true
# Key -> {name, tenant_id, scopes} 映射 JSON（支持简写 {"<key>": "console"}，默认 read+write 全 scope）
# scopes：read=检索/验证/观测（kb-search、kb-sync/verify、kb-cache/status、diagnostic）；
#         write=写路径（kb-sync upsert/delete、kb-cache/invalidate、feedback、cases/close）
# 示例（生产请经密钥管理注入，勿提交仓库）：
# RAG_API_KEYS_JSON={"<console-key>":{"name":"console","tenant_id":"default","scopes":["read","write"]},"<agent-key>":{"name":"agent","tenant_id":"tenant-a","scopes":["read"]}}
RAG_API_KEYS_JSON=
# 身份缺省租户：未显式声明 tenant_id 的 Key 或匿名请求按此租户解析；
# 数据层语义为 "default" 是公共知识层，任意租户可见 {default, 本租户}
RAG_DEFAULT_TENANT=default

# ===== 服务 =====
SERVICE_PORT=8080
