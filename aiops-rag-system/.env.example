# ===== LLM 配置（LangChain ChatOpenAI 兼容接口，支持 DeepSeek/Qwen/OpenAI）=====
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=5
# 底层重试次数，默认 0（端到端 deadline 由 RAG_LLM_TIMEOUT_SECONDS 统一熔断，
# 底层重试会把单请求最长阻塞放大为 timeout*(retries+1)，加剧 P99 长尾）
LLM_MAX_RETRIES=0

# ===== Milvus =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=aiops_knowledge_base
# 单次向量检索超时（秒）
MILVUS_SEARCH_TIMEOUT=3
# 集合句柄缓存 TTL（秒）：TTL 内复用 Collection 对象，省去每次检索的 has_collection RPC
MILVUS_COLLECTION_CACHE_TTL=5

# ===== Embedding（bge-m3：本地路径或 API，留空则使用确定性降级向量）=====
EMBEDDING_MODEL_PATH=BAAI/bge-m3
EMBEDDING_API_URL=
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT=10
# Embedding API 失败熔断：连续失败 N 次后熔断，窗口内直接走降级向量
EMBEDDING_FAIL_THRESHOLD=3
EMBEDDING_CIRCUIT_SECONDS=30

# ===== RAG 检索/并发调优（P99 长尾治理）=====
# 召回候选数与重排后送入 LLM 的案例数：降低 top_k 可显著缩短 Milvus 与重排耗时
RAG_TOP_K=20
RAG_FINAL_K=3
# 端到端 LLM 等待预算（秒）：超时后立即用 top1 检索结果降级，不再等待
RAG_LLM_TIMEOUT_SECONDS=5
# LLM 推理线程池大小：高并发下过小会形成排队长尾，过大受 LLM 服务吞吐约束
RAG_LLM_MAX_WORKERS=8
# 检索时间过滤窗口（天）
RAG_RECENT_WINDOW_DAYS=30

# ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_STANDARDIZED=standardized-events
KAFKA_TOPIC_RAW=raw-alerts

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Elasticsearch =====
ES_HOST=http://localhost:9200
ES_INDEX=aiops-events

# ===== 服务 =====
SERVICE_PORT=8080
